int main(){

int n;
scanf("%d", &n);
for(int i=n;i>0;i--){
  if(i<n) for(int k=n;k>i;k--) printf("%d ",k);
  for(int j=1;j<2*i;j++) printf("%d ",i); 
  if(i<n) for(int l=i+1;l<=n;l++) printf("%d ",l);
  printf("\n");  
}
for(int i=2;i<=n;i++){
    if(i<n) for(int k=n;k>i;k--) printf("%d ",k);
    for(int j=1;j<2*i;j++) printf("%d ",i); 
    if(i<n) for(int l=i+1;l<=n;l++) printf("%d ",l);
    printf("\n");
}
return 0;
}
