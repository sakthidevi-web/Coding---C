char* getPermutation(int n, int k) {
    int fact[10];
    int nums[10];
    char* result = (char*)malloc((n + 1) * sizeof(char));

    fact[0] = 1;
    for (int i = 1; i <= n; i++) {
        fact[i] = fact[i - 1] * i;
        nums[i - 1] = i;
    }
    k--;

    for (int i = 0; i < n; i++) {
        int idx = k / fact[n - 1 - i];
        result[i] = nums[idx] + '0';

        for (int j = idx; j < n - 1 - i; j++) {
            nums[j] = nums[j + 1];
        }

        k %= fact[n - 1 - i];
    }

    result[n] = '\0';
    return result;
}
