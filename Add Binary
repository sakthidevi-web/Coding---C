char* addBinary(char* a, char* b) {
    int lenA = strlen(a);
    int lenB = strlen(b);
    int maxLen = (lenA > lenB ? lenA : lenB) + 1; 

    char* result = (char*)malloc(maxLen + 1); 
    if (!result) return NULL;

    result[maxLen] = '\0'; 

    int carry = 0, sum = 0;
    int i = lenA - 1, j = lenB - 1, k = maxLen - 1;

    while (i >= 0 || j >= 0 || carry) {
        sum = carry;
        if (i >= 0) sum += a[i--] - '0';
        if (j >= 0) sum += b[j--] - '0';

        result[k--] = (sum % 2) + '0';
        carry = sum / 2;
    }

    if (k == -1) return result; 
    else {
        char* shiftedResult = (char*)malloc(maxLen - k);
        if (!shiftedResult) {
            free(result);
            return NULL;
        }
        strcpy(shiftedResult, result + k + 1);
        free(result);
        return shiftedResult;
    }
}
