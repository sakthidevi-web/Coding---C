int cmp(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}

void backtrack(int *nums, int numsSize, bool *used,
               int *temp, int tempSize,
               int ***result, int *returnSize, int *returnColumnSizes) {
    
    if (tempSize == numsSize) {
        (*result)[*returnSize] = (int *)malloc(sizeof(int) * numsSize);
        for (int i = 0; i < numsSize; i++) {
            (*result)[*returnSize][i] = temp[i];
        }
        returnColumnSizes[*returnSize] = numsSize;
        (*returnSize)++;
        return;
    }

    for (int i = 0; i < numsSize; i++) {
        if (used[i])
            continue;

        if (i > 0 && nums[i] == nums[i - 1] && !used[i - 1])
            continue;

        used[i] = true;
        temp[tempSize] = nums[i];
        backtrack(nums, numsSize, used, temp, tempSize + 1,
                  result, returnSize, returnColumnSizes);
        used[i] = false;
    }
}

int** permuteUnique(int* nums, int numsSize,
                    int* returnSize, int** returnColumnSizes) {
    
    qsort(nums, numsSize, sizeof(int), cmp);

    int maxPermutations = 50000;
    int **result = (int **)malloc(sizeof(int *) * maxPermutations);
    *returnColumnSizes = (int *)malloc(sizeof(int) * maxPermutations);

    bool *used = (bool *)calloc(numsSize, sizeof(bool));
    int *temp = (int *)malloc(sizeof(int) * numsSize);

    *returnSize = 0;

    backtrack(nums, numsSize, used, temp, 0,
              &result, returnSize, *returnColumnSizes);

    free(used);
    free(temp);

    return result;
}
