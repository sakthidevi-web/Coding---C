char* longestCommonPrefix(char** strs, int strsSize) {
    if (strsSize == 0)
        return "";

    int prefixLen = strlen(strs[0]);

    for (int i = 1; i < strsSize; i++) {
        int j = 0;
        while (j < prefixLen && strs[0][j] == strs[i][j]) {
            j++;
        }
        prefixLen = j;

        if (prefixLen == 0)
            return "";
    }

    strs[0][prefixLen] = '\0';
    return strs[0];
}
