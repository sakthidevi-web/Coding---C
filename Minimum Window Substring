char* minWindow(char* s, char* t) {
    int sLen = strlen(s);
    int tLen = strlen(t);

    if (sLen == 0 || tLen == 0) return strdup("");

    int tCount[128] = {0};
    int windowCount[128] = {0};

    for (int i = 0; i < tLen; i++) {
        tCount[(int)t[i]]++;
    }

    int required = 0; 
    for (int i = 0; i < 128; i++) {
        if (tCount[i] > 0) required++;
    }

    int formed = 0; 
    int left = 0, right = 0;
    int minLen = INT_MAX, minLeft = 0;

    while (right < sLen) {
        char c = s[right];
        windowCount[(int)c]++;

        if (tCount[(int)c] > 0 && windowCount[(int)c] == tCount[(int)c]) {
            formed++;
        }

        while (left <= right && formed == required) {
            c = s[left];

            if (right - left + 1 < minLen) {
                minLen = right - left + 1;
                minLeft = left;
            }

            windowCount[(int)c]--;
            if (tCount[(int)c] > 0 && windowCount[(int)c] < tCount[(int)c]) {
                formed--;
            }

            left++;
        }

        right++;
    }

    if (minLen == INT_MAX) return strdup("");
    
    char* result = (char*)malloc(minLen + 1);
    strncpy(result, s + minLeft, minLen);
    result[minLen] = '\0';
    return result;
}
